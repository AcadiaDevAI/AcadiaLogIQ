*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg

# Environments — NEVER commit secrets
.env
.env.local
.env.production
.venv/
venv/
env/
backend/env.bvk

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Application data
# Anchor to repo-root so this only ignores the runtime file-storage
# directory (./uploads/) and NOT the Python package backend/uploads/
# (which holds schemas.py / service.py / keys.py and must ship to
# the deployed image). Without the leading slash, `uploads/` matched
# `backend/uploads/` too and the package never reached git → EC2
# deploys failed at import time with ModuleNotFoundError.
/uploads/
data/
*.db
*.sqlite
*.sqlite3
*.log
logs/

# Node
node_modules/
frontend/node_modules/
frontend/build/
frontend/coverage/

# npm / yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary
*.tmp
*.bak

.claude/settings.local.json
